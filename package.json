{
  "name": "lian-mobile-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite preview --host 0.0.0.0 --port 4301 --strictPort",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/validate-project-structure.js && node scripts/check-encoding-contamination.js && npm run check:runtime-exposure && npm run check:unsafe-dom && npm run check:view-boundary && npm run check:asset-owners && npm run check:stale-docs && npm run check:large-vue && npm run check:ownership-doc && npm run format:check && npm run lint",
    "check:encoding": "node scripts/check-encoding-contamination.js",
    "check:runtime-exposure": "node scripts/guard-public-runtime-exposure.js",
    "check:unsafe-dom": "node scripts/guard-unsafe-dom-sinks.js",
    "check:view-boundary": "node scripts/check-view-imports-composable.mjs",
    "check:asset-owners": "node scripts/warn-public-asset-owners.js",
    "check:stale-docs": "node scripts/warn-stale-doc-keywords.js",
    "check:large-vue": "node scripts/warn-large-vue-files.js",
    "check:ownership-doc": "node scripts/generate-ownership-doc.js --check",
    "check:dead-code": "knip --reporter compact",
    "check:stale-code": "node scripts/track-stale-code.js",
    "ownership-doc": "node scripts/generate-ownership-doc.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:v-html": "node scripts/audit-v-html-usage.js",
    "test:html-sanitizer": "node scripts/test-html-sanitizer.js",
    "ops:guard": "node scripts/guard-runtime-inventory.js",
    "test": "node scripts/smoke-vue-frontend.js http://127.0.0.1:4301",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:runtime-exposure-guard": "node scripts/test-guard-public-runtime-exposure.js",
    "verify:static": "npm run check && npm run ops:guard && npm run build",
    "verify:smoke": "node scripts/run-smoke-with-server.js --port 4301 -- npm run test:vue",
    "verify": "npm run verify:static && npm run test:unit && npm run verify:smoke",
    "test:vue": "node scripts/smoke-vue-frontend.js http://127.0.0.1:4301"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.49.1",
    "@types/leaflet": "^1.9.20",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "knip": "^6.14.1",
    "prettier": "^3.8.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.2.0"
  }
}
