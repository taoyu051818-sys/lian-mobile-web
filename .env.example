# Frontend local development only.
# Do not put production secrets in this file.

LIAN_BACKEND_BASE_URL=http://127.0.0.1:4200
LIAN_IMAGE_PROXY_BASE_URL=http://127.0.0.1:4201
VITE_COMMERCE_CATALOG_VISIBLE=false
VITE_COMMERCE_PRODUCT_VISIBLE=false
VITE_COMMERCE_CART_VISIBLE=false

# Development-only UI fixtures. Both variables must be set for a preview to
# appear, and production builds drop the code path entirely because it is
# additionally gated on import.meta.env.DEV.
# Scenarios: normal | long-copy | many-items | zero-rating | missing-summary
#            loading | empty | error | timeout | rate-limited
# VITE_UI_FIXTURES=true
# VITE_UI_FIXTURE_SCENARIO=normal
